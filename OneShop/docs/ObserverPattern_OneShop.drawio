        <mxCell id="legend" value="&lt;b&gt;So khớp sách (ảnh mẫu)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Publisher → OrderStatusPublisher&amp;nbsp;|&amp;nbsp;Subscriber → OrderStatusSubscriber&amp;nbsp;|&amp;nbsp;update(context) → update(event)&lt;br&gt;notifySubscribers() → notifySubscribers(event)&amp;nbsp;|&amp;nbsp;context → OrderStatusChangedEvent&lt;br&gt;mainBusinessLogic / đổi state: Order + OrderState + OrderServiceImpl; sau đó client gọi notify.&lt;/font&gt;" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="960" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
