<mxfile host="app.diagrams.net" modified="2026-03-30T00:00:00.000Z" agent="OneShop" version="22.1.0" type="device">
  <diagram id="observer-oneshop" name="Observer Pattern - OneShop">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;Observer (Publisher–Subscriber) — OneShop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;vn.observer.order + OrderServiceImpl (client)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="560" height="44" as="geometry" />
        </mxCell>

        <mxCell id="note-spring" value="&lt;b&gt;Client / wiring (thực tế)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• Spring IoC gom mọi bean &lt;i&gt;OrderStatusSubscriber&lt;/i&gt; vào &lt;code&gt;List&amp;lt;...&amp;gt;&lt;/code&gt; khi tạo &lt;i&gt;OrderStatusPublisher&lt;/i&gt;.&lt;br&gt;• Tương đương &lt;i&gt;subscribe&lt;/i&gt; lúc khởi động (không có subscribe/unsubscribe runtime như sơ đồ sách tối giản).&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=14;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cls-event" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;OrderStatusChangedEvent&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;&lt;i&gt;«context / payload»&lt;/i&gt;&lt;br&gt;- orderId: Long&lt;br&gt;- userId: Long&lt;br&gt;- customerEmail: String&lt;br&gt;- customerName: String&lt;br&gt;- oldStatus: OrderStatus&lt;br&gt;- newStatus: OrderStatus&lt;br&gt;- changedAt: LocalDateTime&lt;br&gt;- source: String&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;+ getters&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="260" height="220" as="geometry" />
        </mxCell>

        <mxCell id="cls-publisher" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;OrderStatusPublisher&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;text-align:center;&quot;&gt;&lt;i&gt;«Publisher» @Component&lt;/i&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;- subscribers: List&amp;lt;OrderStatusSubscriber&amp;gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;+ OrderStatusPublisher(subscribers)&lt;br&gt;+ notifySubscribers(event)&lt;br&gt;&lt;i&gt;&amp;nbsp;&amp;nbsp;// foreach s: subscribers&amp;nbsp;s.update(event)&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="88" width="300" height="160" as="geometry" />
        </mxCell>

        <mxCell id="cls-subscriber" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;«interface»&lt;/b&gt;&lt;br&gt;&lt;b&gt;OrderStatusSubscriber&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;+ update(event: OrderStatusChangedEvent)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;fillColor=#fff4c3;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="cls-email" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;EmailOrderStatusSubscriber&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;text-align:center;&quot;&gt;&lt;i&gt;«Concrete Subscriber» @Component&lt;/i&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;- sendMailService&lt;br&gt;- orderRepository&lt;br&gt;- emailComposer&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;+ update(event)&lt;br&gt;&lt;i&gt;// queue email HTML&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="260" width="280" height="170" as="geometry" />
        </mxCell>

        <mxCell id="cls-audit" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;AuditOrderStatusSubscriber&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;text-align:center;&quot;&gt;&lt;i&gt;«Concrete Subscriber» @Component&lt;/i&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;&lt;i&gt;(static log constants)&lt;/i&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;+ update(event)&lt;br&gt;&lt;i&gt;// console ORDER_AUDIT&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="720" y="460" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cls-client" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;OrderServiceImpl&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;text-align:center;&quot;&gt;&lt;i&gt;«Client» @Service&lt;/i&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;- orderStatusPublisher&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0px;margin-left:4px;text-align:left;&quot;&gt;- publishOrderStatusChanged(...)&lt;br&gt;&lt;i&gt;// tạo OrderStatusChangedEvent&amp;nbsp;&lt;br&gt;publisher.notifySubscribers(event)&lt;/i&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;fontSize=11;fontFamily=Helvetica;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="380" y="520" width="300" height="140" as="geometry" />
        </mxCell>

