# Sao chép thành file .env trong cùng thư mục với docker-compose.yml:
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
#
# Mật khẩu SA phải đạt yêu cầu của Microsoft: tối thiểu 8 ký tự, có chữ hoa, thường, số và ký tự đặc biệt.

MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# URL app khi user mở trình duyệt từ máy thật (link trong email)
APP_BASE_URL=http://localhost:8080
