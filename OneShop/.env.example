# Sao chép thành file .env trong cùng thư mục với docker-compose.yml:
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
#
# Mật khẩu SA phải đạt yêu cầu của Microsoft: tối thiểu 8 ký tự, có chữ hoa, thường, số và ký tự đặc biệt.

MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# URL app khi user mở trình duyệt từ máy thật (email, OAuth redirect, thanh toán).
# Local: http://localhost:8080
# VPS trực tiếp port 8080: http://YOUR_IP:8080  (không để dấu / cuối)
# Production + Nginx + HTTPS: https://oneshophcmute.com
# Google/Facebook: thêm ĐÚNG redirect URI tương ứng trong console (xem docs/DOCKER.md).
APP_BASE_URL=http://localhost:8080
